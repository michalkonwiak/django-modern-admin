msgstr[0] "zaznaczono %(count)s wiersz"
msgstr[1] "zaznaczono %(count)s wiersze"
msgstr[2] "zaznaczono %(count)s wierszy"

#: modern_admin/static/modern_admin/app.js:394
msgid "%(selected)s of %(total)s selected"
msgstr "zaznaczono %(selected)s z %(total)s"

#: modern_admin/static/modern_admin/app.js:397
msgid "No match for “%(query)s”."
msgstr "Brak dopasowania dla „%(query)s”."

#: modern_admin/static/modern_admin/app.js:482
msgid "That request could not be completed. Please try again."
msgstr "Nie udało się wykonać tego żądania. Spróbuj ponownie."
