#: modern_admin/static/modern_admin/app.js:42
msgid "Dismiss"
msgstr "Odrzuć"

#: modern_admin/static/modern_admin/app.js:179
msgid "Loading…"
msgstr "Wczytywanie…"

#: modern_admin/static/modern_admin/app.js:192
msgid "Page %(page)s of %(pages)s"
